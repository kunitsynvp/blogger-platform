#INFRASTRUCTURE + SECRETS + DANGEROUS CONFIGURATIONS

MONGODB_URI="mongodb://localhost:27017/development"
PORT=3000
ACCESS_TOKEN_SECRET=accessTokenSecret
REFRESH_TOKEN_SECRET=refreshTokenSecret
IS_SWAGGER_ENABLED=true
IS_USER_AUTO_CONFIRMED=false
IS_TESTING_MODULE_INCLUDED=true
