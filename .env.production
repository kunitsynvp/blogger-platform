#INFRASTRUCTURE + SECRETS + DANGEROUS CONFIGURATIONS#

NODE_ENV=

#URI для основной базы данных Mongo
MONGODB_URI=

# порт, на котором запускается приложение
PORT=

#Тип БД, который будет использоваться в typeORM
DB_TYPE=

#Хост БД
DB_HOST=

#Порт для БД
DB_PORT=

#Имя пользователя бд
DB_USERNAME=

#Пароль пользователя бд
DB_USER_PASSWORD=

# должен ли быть открыт Swagger
IS_SWAGGER_ENABLED=

#ключ для подписи токена
ACCESS_TOKEN_SECRET=

#ключ для подписи токена
REFRESH_TOKEN_SECRET=

#Автоматическое подтверждение пользователя ОПАСНО true|false
IS_USER_AUTO_CONFIRMED=

#Используется ли тестинг модуль в приложении
IS_TESTING_MODULE_INCLUDED=

#DANGEROUS SHOULD BE FALSE IN PRODUCTION
DB_IS_AUTO_LOAD_ENTITIES=

#DANGEROUS SHOULD BE FALSE IN PRODUCTION
DB_IS_SYNCHRONIZE=

#APPLICATION/DOMAIN SETTINGS#

#jwt access token expiring time
JWT_ACCESS_TOKEN_EXPIRE_IN=5m

#jwt refresh token expiring time
JWT_REFRESH_TOKEN_EXPIRE_IN=60m

#Количество самых новых лайков для поста, которые будут возвращаться с ним при get-запросе
GET_EXTENDED_LIKES_INFO_LIKES_AMOUNT=3

#Количество часов до истечения срока подтверждения почты пользователя
EMAIL_CONFIRMATION_EXPIRE_IN_HOURS=1

#Период времени в течение которого проверяется ограничение запросов
THROTTLER_TTL_IN_MS=10000

#Максимальное количество запросов за период времени(TTL)
THROTTLER_LIMIT=5

#Название БД
DB_NAME=BloggerPlatform


